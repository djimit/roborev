{
  "name": "roborev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Commit-native review daemon. Emits review events as Djimitflo work items via JSONL spillover.",
  "bin": {
    "roborev": "./bin/roborev.mjs"
  },
  "scripts": {
    "emit:example": "roborev emit < examples/emit-review-failed.json --out /tmp/roborev-test.pending.jsonl",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
